{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Phoenixx1202/PS4-React/app.schema.json",
  "title": "PS4 React app manifest",
  "description": "Metadata and render settings for a PS4 React application.",
  "type": "object",
  "required": ["titleId", "contentId", "name", "version", "render", "surface"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "titleId": {
      "type": "string",
      "description": "PS4 title ID, for example CUSA99059.",
      "pattern": "^[A-Z]{4}[0-9]{5}$"
    },
    "contentId": {
      "type": "string",
      "description": "36-character PS4 content ID.",
      "pattern": "^[A-Z]{2}[0-9]{4}-[A-Z]{4}[0-9]{5}_00-[A-Z0-9]{16}$"
    },
    "name": {
      "type": "string",
      "description": "Title shown by the PS4 dashboard and in the PKG.",
      "minLength": 1,
      "maxLength": 127
    },
    "version": {
      "type": "string",
      "description": "Application version in MM.mmm.mmm form.",
      "pattern": "^[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}$"
    },
    "render": {
      "$ref": "#/$defs/size",
      "description": "Logical render target used while compiling Tailwind classes."
    },
    "surface": {
      "$ref": "#/$defs/size",
      "description": "Expected display surface. PS4 builds currently use 1920x1080."
    },
    "timeoutSeconds": {
      "type": "number",
      "description": "Optional watchdog timeout for automated runs.",
      "minimum": 1
    },
    "networking": {
      "type": "boolean",
      "description": "Whether the app may open network connections.",
      "default": true
    },
    "filesystemAccess": {
      "type": "string",
      "description": "sandbox exposes app paths; console also allows mounted filesystems.",
      "enum": ["sandbox", "console"],
      "default": "sandbox"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 2160
        }
      },
      "additionalProperties": false
    }
  }
}
